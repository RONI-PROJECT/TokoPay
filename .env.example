# ===== TokoPayVIP Environment =====
# Copy file ini jadi .env lalu isi nilai asli. JANGAN commit .env asli.

# URL frontend / public
PUBLIC_URL="https://tokopayvip.vercel.app/"
PUBLIC_API_BASE_URL="https://tokopayvip.vercel.app/"

# Server
PORT=3000
TRUST_PROXY=1

# Transaksi
EXPIRE_MINUTES=30
BACKGROUND_POLL=1
POLL_MIN_INTERVAL_MS=3000
SANDBOX_MODE=0

# Database Neon Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# GoPay (auto-settle)
GOPAY_EMAIL="email@kamu.com"
GOPAY_PASSWORD="password"
GOPAY_ACCESS_TOKEN=""
GOPAY_MERCHANT_ID=""

# QRIS statis
QRIS_STRING=""

# Webhook
WEBHOOK_URL=""
WEBHOOK_URL_TEMPLATE="https://{domain}/webhook"
WEBHOOK_SECRET=""

# Master API key
API_KEY=""

# Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA-XXXXXXXXXXX"
TURNSTILE_SITE_KEY="0x4AAAAAAA-XXXXXXXXXXX"
TURNSTILE_SECRET_KEY="0x4AAAAAAA-XXXXXXXXXXX"

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD="passwordkuat"

# Rate limit
RATE_MAX=1000
